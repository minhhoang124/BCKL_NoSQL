# syntax=docker/dockerfile:1
# Web (React + Vite) served by nginx. Build context: repository root.
#   docker build -f FE/Dockerfile --build-arg VITE_API_URL=http://localhost:3001 -t bckl-web .
# VITE_* values are compiled into the bundle: never pass secrets here.
FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY FE/package.json FE/
RUN pnpm install --frozen-lockfile --filter fe...
COPY FE FE

ARG VITE_API_URL=http://localhost:3001
ARG VITE_ACCOUNT_BUYER_ACCESS_ENABLED=true
ARG VITE_ACCOUNT_SETTINGS_ENABLED=true
ARG VITE_ADMIN_ACCOUNT_STATUS_ENABLED=true
ARG VITE_AFTERSALES_ENABLED=true
ARG VITE_AUTH_EMAIL_ENABLED=false
ARG VITE_AUTH_EMAIL_SANDBOX=false
ARG VITE_AUTH_GOOGLE_ENABLED=false
ARG VITE_AUTH_PASSWORD_CHANGE_MODE=DIRECT
ARG VITE_AUTH_PHONE_OTP_ENABLED=false
ARG VITE_BUYER_ORDER_COMMANDS_ENABLED=true
ARG VITE_CHAT_ENABLED=true
ARG VITE_CHAT_ORDER_CONTEXT_ENABLED=true
ARG VITE_CHAT_PRODUCT_CONTEXT_ENABLED=true
ARG VITE_IMAGE_SEARCH_ENABLED=false
ARG VITE_NOTIFICATIONS_ENABLED=true
ARG VITE_PRODUCT_REVIEWS_ENABLED=true
ARG VITE_SELLER_ONBOARDING_ENABLED=true
ARG VITE_SELLER_ORDER_COMMANDS_ENABLED=true
ARG VITE_SELLER_VARIANT_INVENTORY_ENABLED=true
ARG VITE_VNPAY_SANDBOX_ENABLED=false
ENV VITE_API_URL=$VITE_API_URL \
    VITE_ACCOUNT_BUYER_ACCESS_ENABLED=$VITE_ACCOUNT_BUYER_ACCESS_ENABLED \
    VITE_ACCOUNT_SETTINGS_ENABLED=$VITE_ACCOUNT_SETTINGS_ENABLED \
    VITE_ADMIN_ACCOUNT_STATUS_ENABLED=$VITE_ADMIN_ACCOUNT_STATUS_ENABLED \
    VITE_AFTERSALES_ENABLED=$VITE_AFTERSALES_ENABLED \
    VITE_AUTH_EMAIL_ENABLED=$VITE_AUTH_EMAIL_ENABLED \
    VITE_AUTH_EMAIL_SANDBOX=$VITE_AUTH_EMAIL_SANDBOX \
    VITE_AUTH_GOOGLE_ENABLED=$VITE_AUTH_GOOGLE_ENABLED \
    VITE_AUTH_PASSWORD_CHANGE_MODE=$VITE_AUTH_PASSWORD_CHANGE_MODE \
    VITE_AUTH_PHONE_OTP_ENABLED=$VITE_AUTH_PHONE_OTP_ENABLED \
    VITE_BUYER_ORDER_COMMANDS_ENABLED=$VITE_BUYER_ORDER_COMMANDS_ENABLED \
    VITE_CHAT_ENABLED=$VITE_CHAT_ENABLED \
    VITE_CHAT_ORDER_CONTEXT_ENABLED=$VITE_CHAT_ORDER_CONTEXT_ENABLED \
    VITE_CHAT_PRODUCT_CONTEXT_ENABLED=$VITE_CHAT_PRODUCT_CONTEXT_ENABLED \
    VITE_IMAGE_SEARCH_ENABLED=$VITE_IMAGE_SEARCH_ENABLED \
    VITE_NOTIFICATIONS_ENABLED=$VITE_NOTIFICATIONS_ENABLED \
    VITE_PRODUCT_REVIEWS_ENABLED=$VITE_PRODUCT_REVIEWS_ENABLED \
    VITE_SELLER_ONBOARDING_ENABLED=$VITE_SELLER_ONBOARDING_ENABLED \
    VITE_SELLER_ORDER_COMMANDS_ENABLED=$VITE_SELLER_ORDER_COMMANDS_ENABLED \
    VITE_SELLER_VARIANT_INVENTORY_ENABLED=$VITE_SELLER_VARIANT_INVENTORY_ENABLED \
    VITE_VNPAY_SANDBOX_ENABLED=$VITE_VNPAY_SANDBOX_ENABLED
RUN pnpm --filter fe run build

FROM nginx:1.27-alpine AS runtime
COPY FE/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/FE/dist /usr/share/nginx/html
EXPOSE 80
