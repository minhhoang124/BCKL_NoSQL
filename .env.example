POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=klcn_ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/klcn_ecommerce
BACKEND_PORT=3001

# D07: real DB-backed runtime completion after 3 days; shorter delay demo only.
ORDER_AUTO_COMPLETE_ENABLED=true
ORDER_AUTO_COMPLETE_DELAY_SECONDS=259200
BACKEND_PUBLIC_URL=http://localhost:3001
UPLOAD_ROOT=../uploads
FRONTEND_URL=http://localhost:5173
# Seller detail integration: true by default; false keeps the read-only fallback.
# UI rollback only; Backend ownership/state checks remain authoritative.
VITE_SELLER_ORDER_COMMANDS_ENABLED=true
# Buyer detail integration: true by default; false keeps the read-only fallback.
# UI rollback only; Backend ownership/state checks remain authoritative.
VITE_BUYER_ORDER_COMMANDS_ENABLED=true
VITE_API_URL=http://localhost:3001
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=klcn-ecommerce-api
JWT_AUDIENCE=klcn-ecommerce-web
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
# Internal health only. Set a separate random secret outside Git; blank disables probes.
# Backend and AI health tokens must match; generate privately, never commit a value.
AI_INTERNAL_HEALTH_TOKEN=
SEARCH_INTERNAL_HEALTH_TOKEN=
AI_SEARCH_TIMEOUT_MS=10000
# Enable Web route only after Backend image gateway #102 is integrated/QA verified.
# Vite variables belong in FE environment; do not expose server credentials.
VITE_IMAGE_SEARCH_ENABLED=false
AI_IMAGE_URL_ALLOWED_HOSTS=backend,localhost,127.0.0.1,::1
ELASTICSEARCH_URL=http://localhost:9200
SEARCH_RECONCILIATION_ENABLED=true
PRODUCT_IMAGE_REPAIR_ENABLED=true
PRODUCT_IMAGE_REPAIR_BATCH_SIZE=50
PRODUCT_IMAGE_REPAIR_BACKOFF_SECONDS=60
ADDRESS_MAX_PER_USER=20
CART_MAX_QUANTITY=99
CART_RATE_LIMIT_PER_MINUTE=60
# Shared Buyer/Seller Order list + detail read quota, per actor/instance.
ORDER_LIST_RATE_PER_MINUTE=60
ORDER_COMMAND_RATE_PER_MINUTE=20
# Independent per-instance Buyer resolve-command ingress bucket, not execution.
BUYER_RESOLUTION_RATE_PER_MINUTE=20
ORDER_COMMAND_STATEMENT_TIMEOUT_MS=2000
ORDER_COMMAND_LOCK_TIMEOUT_MS=1000
ORDER_COMMAND_TRANSACTION_TIMEOUT_MS=5000
ORDER_COMMAND_MAX_WAIT_MS=2000
ORDER_COMMAND_DEADLINE_MS=22000
CHECKOUT_PREVIEW_RATE_PER_MINUTE=20
CHECKOUT_LOOKUP_RATE_PER_MINUTE=20
CHECKOUT_CREATE_INGRESS_PER_MINUTE=60
CHECKOUT_CREATE_INTENTS_PER_MINUTE=5
CHECKOUT_STATEMENT_TIMEOUT_MS=2000
CHECKOUT_LOCK_TIMEOUT_MS=1000
CHECKOUT_TRANSACTION_TIMEOUT_MS=5000
CHECKOUT_MAX_WAIT_MS=2000
CHECKOUT_DEADLINE_MS=22000
ORDER_CANCEL_RATE_PER_MINUTE=20
ORDER_CANCEL_STATEMENT_TIMEOUT_MS=2000
ORDER_CANCEL_LOCK_TIMEOUT_MS=1000
ORDER_CANCEL_TRANSACTION_TIMEOUT_MS=5000
ORDER_CANCEL_MAX_WAIT_MS=2000
ORDER_CANCEL_DEADLINE_MS=22000
# Server-side opt-in for SELLER acting on its own Buyer resources.
# Phase A Backend only; does not enable public Seller signup or new Store grants.
ACCOUNT_BUYER_ACCESS_ENABLED=false
# Public build flag; enable in QA only alongside the Backend flag above.
VITE_ACCOUNT_BUYER_ACCESS_ENABLED=false
# Enable only after additive migration and all Auth replicas are upgraded.
ACCOUNT_SETTINGS_WRITE_ENABLED=false
VITE_ACCOUNT_SETTINGS_ENABLED=false
# Chat TEXT REST rollout; migrate first, runtime QA/review before enabling.
CHAT_TEXT_ENABLED=false
